{
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "rootDir": "src",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2020",
    "strict": true,
    "skipLibCheck": true,
    "types": ["vitest/globals"],
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", ".rollup.cache"],
}
