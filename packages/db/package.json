{
  "name": "@jsonkit/db",
  "version": "3.0.1",
  "description": "Simple database using JSON and your local filesystem",
  "license": "MIT",
  "author": "taennan <taennan.dev@protonmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taennan/jsonkit.git"
  },
  "keywords": [
    "typescript",
    "json",
    "database",
    "filesystem"
  ],
  "type": "module",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "default": "./dist/esm/index.js",
        "types": "./dist/index.d.ts"
      },
      "require": {
        "default": "./dist/cjs/index.cjs",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "scripts": {
    "build": "npm run clean && npm run build:bundle",
    "clean": "rm -rf dist",
    "check": "tsc --noEmit",
    "build:bundle": "npx rollup -c",
    "build:bundle_v2": "npx rollup -c --configPlugin @rollup/plugin-typescript",
    "build:types": "tsc -p tsconfig.json",
    "fmt": "prettier --write .",
    "test": "jest"
  },
  "files": [
    "dist"
  ]
}
